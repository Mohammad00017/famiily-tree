<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Islamic Prophets Family Tree</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Amiri:wght@400;700&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
background: #0a0a0f;
font-family: ‘Amiri’, serif;
color: #f0e6c8;
}

.poster {
width: 1400px;
margin: 0 auto;
background: linear-gradient(160deg, #0d1117 0%, #111827 50%, #0d1117 100%);
border: 4px solid #b8964e;
position: relative;
overflow: hidden;
}

/* Background pattern */
.poster::before {
content: ‘’;
position: absolute; inset: 0;
background-image:
repeating-linear-gradient(60deg, transparent, transparent 50px, rgba(184,150,78,0.025) 50px, rgba(184,150,78,0.025) 51px),
repeating-linear-gradient(-60deg, transparent, transparent 50px, rgba(184,150,78,0.025) 50px, rgba(184,150,78,0.025) 51px);
pointer-events: none; z-index: 0;
}

/* Corner ornaments */
.corner { position:absolute; width:70px; height:70px; z-index:2; }
.corner-tl { top:10px; left:10px; border-top:3px solid #b8964e; border-left:3px solid #b8964e; }
.corner-tr { top:10px; right:10px; border-top:3px solid #b8964e; border-right:3px solid #b8964e; }
.corner-bl { bottom:10px; left:10px; border-bottom:3px solid #b8964e; border-left:3px solid #b8964e; }
.corner-br { bottom:10px; right:10px; border-bottom:3px solid #b8964e; border-right:3px solid #b8964e; }

/* HEADER */
.header {
position: relative; z-index:1;
text-align: center;
padding: 28px 20px 16px;
border-bottom: 2px solid #b8964e;
background: linear-gradient(180deg, rgba(184,150,78,0.12) 0%, transparent 100%);
}
.bismillah {
font-family: ‘Scheherazade New’, serif;
font-size: 30px; color: #d4af6e; margin-bottom: 6px;
}
.main-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: 32px; color: #f0d080;
text-shadow: 0 0 30px rgba(240,208,128,0.4);
letter-spacing: 4px;
}
.hinglish-title {
font-size: 17px; color: #b8964e; margin-top: 4px; letter-spacing: 1px;
}
.ayat {
font-size: 12px; color: #6a7a5a; margin-top: 6px; font-style: italic;
}

/* MAIN LAYOUT */
.layout {
display: grid;
grid-template-columns: 190px 1fr 200px;
position: relative; z-index:1;
}

/* SIDE PANELS */
.side-panel {
padding: 14px 10px;
border-right: 1px solid rgba(184,150,78,0.3);
font-size: 10px;
}
.side-panel.right-panel {
border-right: none;
border-left: 1px solid rgba(184,150,78,0.3);
}
.panel-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: 10px; color: #f0d080;
text-align: center;
border-bottom: 1px solid #b8964e;
padding-bottom: 5px; margin-bottom: 8px;
letter-spacing: 1px;
}

/* Surah list */
.surah-row {
display: flex; gap: 3px;
margin-bottom: 1.5px; font-size: 9px; line-height: 1.4;
}
.s-num { color: #b8964e; min-width: 18px; font-size: 8px; font-weight: bold; }
.s-name { color: #d4af6e; }
.meccan { color: #4a9a6a; }
.medinan { color: #c04040; }

/* 99 Names */
.asma-item {
display: flex; gap: 3px; align-items: flex-start;
margin-bottom: 2px; font-size: 8.5px;
border-bottom: 1px solid rgba(184,150,78,0.08);
padding-bottom: 1.5px;
}
.asma-num { color: #b8964e; min-width: 18px; font-size: 7.5px; }
.asma-arabic { font-family: ‘Scheherazade New’, serif; font-size: 12px; color: #d4af6e; line-height: 1.2; }
.asma-meaning { color: #7a8a6a; font-size: 8px; }

/* ===================== TREE AREA ===================== */
.tree-area {
padding: 16px 8px;
overflow-x: auto;
}

/* Each row of prophets */
.tree-row {
display: flex;
justify-content: center;
align-items: flex-start;
position: relative;
margin-bottom: 0;
}

/* Prophet Box */
.nabi {
display: flex;
flex-direction: column;
align-items: center;
position: relative;
}

.nabi-box {
background: linear-gradient(135deg, #1a2535, #0f1820);
border: 2px solid #b8964e;
border-radius: 8px;
padding: 5px 8px;
text-align: center;
min-width: 100px;
max-width: 130px;
position: relative;
box-shadow: 0 2px 12px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.04);
cursor: default;
}
.nabi-box.green {
border-color: #5aaa7a;
background: linear-gradient(135deg, #0f1f15, #1a2f1a);
box-shadow: 0 0 14px rgba(90,170,120,0.15);
}
.nabi-box.gold {
border-color: #f0d080;
background: linear-gradient(135deg, #1f1800, #2a2200);
box-shadow: 0 0 22px rgba(240,208,128,0.25);
}
.nabi-box.blue {
border-color: #5a8aaa;
background: linear-gradient(135deg, #0f1520, #1a2030);
}

.nabi-num {
font-size: 7.5px; color: #b8964e; font-weight: bold;
margin-bottom: 1px;
}
.nabi-name-en {
font-family: ‘Cinzel Decorative’, serif;
font-size: 11px; color: #f0e6c8; line-height: 1.2;
}
.nabi-name-ar {
font-family: ‘Scheherazade New’, serif;
font-size: 16px; color: #d4af6e; direction: rtl; line-height: 1.1;
}
.nabi-qaum {
font-size: 8px; color: #7a9a8a; margin-top: 1px;
}
.nabi-zikr {
font-size: 7.5px; color: #b8964e; margin-top: 1px;
}
.nabi-khas {
font-size: 7.5px; color: #8a9a6a; font-style: italic; margin-top: 1px;
border-top: 1px solid rgba(184,150,78,0.2); padding-top: 2px; margin-top: 3px;
}

/* ===== SVG CONNECTOR LINES ===== */
.connector-svg {
display: block;
width: 100%;
overflow: visible;
}

/* Small node for non-prophet ancestors */
.anc {
background: rgba(20,28,40,0.9);
border: 1px solid rgba(184,150,78,0.4);
border-radius: 4px;
padding: 2px 7px;
font-size: 8.5px; color: #a89868;
text-align: center;
display: inline-block;
}

/* horizontal chain row */
.chain-row {
display: flex;
align-items: center;
justify-content: center;
flex-wrap: wrap;
gap: 2px;
margin: 2px 0;
}
.chain-arrow { color: #b8964e; font-size: 11px; }

/* vertical connector */
.vc {
width: 2px;
background: linear-gradient(180deg, #b8964e, rgba(184,150,78,0.5));
margin: 0 auto;
}

/* section label */
.section-label {
display: inline-block;
border: 1px solid #b8964e;
padding: 2px 14px;
font-family: ‘Cinzel Decorative’, serif;
font-size: 9px; color: #b8964e;
letter-spacing: 2px;
background: rgba(184,150,78,0.06);
border-radius: 3px;
margin: 4px auto;
}

/* The big split wrapper */
.split-wrap {
display: flex;
justify-content: center;
align-items: flex-start;
gap: 0;
position: relative;
}

.split-branch {
display: flex;
flex-direction: column;
align-items: center;
position: relative;
}

/* horizontal bar for split */
.hbar {
height: 2px;
background: #b8964e;
}

/* legend */
.legend {
display: flex; gap:16px; justify-content:center;
padding: 6px 0; font-size: 9px;
border-top: 1px solid rgba(184,150,78,0.2);
position: relative; z-index:1;
}
.leg-item { display:flex; align-items:center; gap:4px; }
.leg-dot { width:10px; height:10px; border-radius:2px; border:1px solid; }

/* Footer duas */
.footer {
border-top: 2px solid #b8964e;
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 0;
position: relative; z-index:1;
}
.footer-panel {
padding: 10px 14px;
border-right: 1px solid rgba(184,150,78,0.25);
font-size: 9px;
}
.footer-panel:last-child { border-right: none; }
.dua-box {
margin-bottom: 8px; padding: 5px 8px;
background: rgba(184,150,78,0.04);
border-left: 2px solid #b8964e; border-radius: 2px;
}
.dua-arabic {
font-family: ‘Scheherazade New’, serif;
font-size: 14px; color: #d4af6e; direction: rtl; margin-bottom: 2px;
}
.dua-hinglish { color: #8a9a7a; font-size: 8.5px; }

.brand {
text-align: center; padding: 8px;
font-size: 9px; color: #3a3a2a;
border-top: 1px solid rgba(184,150,78,0.15);
position: relative; z-index:1;
letter-spacing: 2px;
}

/* small children row */
.children-row {
display: flex;
justify-content: center;
align-items: flex-start;
gap: 6px;
position: relative;
}

/* top-line connector from parent center to children */
.children-wrap {
display: flex;
flex-direction: column;
align-items: center;
width: 100%;
}

</style>
</head>
